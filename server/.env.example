## SuperDesk server environment variables example
# Copy this file to `.env` and fill in values for local development.
# Do NOT commit real secrets to git.

# Server settings
PORT=3001
NODE_ENV=development

# Client URL (optional)
CLIENT_URL=http://localhost:3000

# Azure Web PubSub for Socket.IO (Production)
AZURE_WEBPUBSUB_CONNECTION_STRING=Endpoint=https://superdesk-socketio.webpubsub.azure.com;AccessKey=YOUR_KEY_HERE;Version=1.0;

# TURN / STUN configuration
# You can provide static TURN servers (comma-separated) and a username/password
# Example: TURN_URLS=turn:turn1.example.com:3478,turn:turn2.example.com:3478
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloudflare TURN (preferred option if you use Cloudflare Realtime TURN keys)
# Option A (TURN Key API): set a TURN key id and the key token
# CLOUDFLARE_TURN_KEY_ID=your_turn_key_id_here
# CLOUDFLARE_TURN_KEY_API_TOKEN=your_turn_key_api_token_here

# Option B (Legacy account-level Realtime TURN): set account id and API token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Fallback provider key name (alternative env var names accepted by server)
# TURN_KEY_ID=  (alias for CLOUDFLARE_TURN_KEY_ID)
# TURN_KEY_API_TOKEN=  (alias for CLOUDFLARE_TURN_KEY_API_TOKEN)
