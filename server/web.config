<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service configuration for Node.js + Socket.io
  Enables WebSockets and proper request handling
-->
<configuration>
  <system.webServer>
    <!-- Enable WebSockets for Socket.io -->
    <webSocket enabled="true" />
    
    <!-- Handle Node.js requests -->
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode"/>
    </handlers>
    
    <!-- Rewrite rules for proper routing -->
    <rewrite>
      <rules>
        <!-- Redirect all requests to Node.js -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^index.js\/debug[\/]?" />
        </rule>
        
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}"/>
        </rule>
        
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <action type="Rewrite" url="index.js"/>
        </rule>
      </rules>
    </rewrite>
    
    <!-- Node.js settings -->
    <iisnode 
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      watchedFiles="*.js;iisnode.yml"
    />
    
    <!-- Security settings -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
    
    <!-- HTTP errors -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
