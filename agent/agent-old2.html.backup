<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SuperDesk Agent</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #09090b;
            color: white;
            height: 100vh;
            overflow: hidden;
            -webkit-app-region: drag;
        }

        /* Titlebar */
        .titlebar {
            -webkit-app-region: drag;
            height: 40px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(20px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .titlebar-title {
            font-size: 13px;
            font-weight: 500;
            opacity: 0.7;
        }

        .titlebar-controls {
            -webkit-app-region: no-drag;
            display: flex;
            gap: 8px;
        }

        .titlebar-button {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .titlebar-button:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .titlebar-button.close:hover {
            background: #ef4444;
            color: white;
        }

        /* Main Layout - Two Panels */
        .app-container {
            display: flex;
            height: 100vh;
            padding-top: 40px;
            -webkit-app-region: no-drag;
        }

        /* Left Panel - Branding */
        .left-panel {
            width: 50%;
            background: #0a006f;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            top: -250px;
            right: -250px;
            pointer-events: none;
        }

        .left-panel::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
            bottom: -200px;
            left: -200px;
            pointer-events: none;
        }

        .brand-content {
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .logo-large {
            width: 100%;
            max-width: 500px;
            margin-bottom: 40px;
            filter: drop-shadow(0 10px 40px rgba(0, 0, 0, 0.3));
            animation: fadeInUp 0.8s ease-out;
        }

        .brand-text {
            font-size: 24px;
            font-weight: 300;
            opacity: 0.9;
            line-height: 1.6;
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        /* Right Panel - Content */
        .right-panel {
            flex: 1;
            background: #09090b;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 60px;
        }

        .right-panel::-webkit-scrollbar {
            width: 8px;
        }

        .right-panel::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }

        .right-panel::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

        .right-panel::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .content-header {
            margin-bottom: 40px;
        }

        .content-title {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 12px;
            color: white;
        }

        .content-subtitle {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.6);
            line-height: 1.5;
        }

        /* Cards */
        .card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.12);
        }

        .card-label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 12px;
            font-weight: 600;
        }

        .card-value {
            font-size: 24px;
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: white;
            word-break: break-all;
        }

        .card-hint {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 8px;
        }

        /* Status Items */
        .status-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .status-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 16px;
            text-align: center;
        }

        .status-label {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 8px;
        }

        .status-value {
            font-size: 14px;
            font-weight: 600;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            animation: pulse 2s infinite;
        }

        .status-dot.offline {
            background: #6b7280;
            animation: none;
        }

        /* Buttons */
        .btn {
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-primary {
            background: white;
            color: #09090b;
            font-weight: 600;
        }

        .btn-primary:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2);
        }

        .btn-secondary {
            background: transparent;
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-secondary:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .btn-danger {
            background: #ef4444;
            color: white;
        }

        .btn-danger:hover:not(:disabled) {
            background: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

        .button-group {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .button-group-full {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Input Groups */
        .input-group {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

        .input-group input {
            flex: 1;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            transition: all 0.2s;
        }

        .input-group input::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .input-group input:focus {
            outline: none;
            border-color: white;
            background: rgba(255, 255, 255, 0.08);
        }

        /* Section Headers */
        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: white;
        }

        .section-icon {
            font-size: 20px;
        }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: #18181b;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 32px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
            animation: modalSlide 0.3s ease-out;
        }

        @keyframes modalSlide {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 24px;
            color: white;
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.6);
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 20px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .share-option {
            background: rgba(255, 255, 255, 0.03);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .share-option:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .share-option.selected {
            background: rgba(255, 255, 255, 0.08);
            border-color: white;
        }

        .share-option-icon {
            font-size: 32px;
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .share-option-content h3 {
            font-size: 16px;
            margin-bottom: 4px;
            color: white;
        }

        .share-option-content p {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.5);
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }

        /* Utility */
        .hidden {
            display: none !important;
        }

        .mt-4 {
            margin-top: 16px;
        }

        .mb-4 {
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <!-- Titlebar -->
    <div class="titlebar">
        <div class="titlebar-title">SuperDesk Agent</div>
        <div class="titlebar-controls">
            <button class="titlebar-button" onclick="window.minimizeWindow()" title="Minimize">─</button>
            <button class="titlebar-button close" onclick="window.closeWindow()" title="Close">✕</button>
        </div>
    </div>

    <!-- Main Container -->
    <div class="app-container">
        <!-- Left Panel - Branding -->
        <div class="left-panel">
            <div class="brand-content">
                <img src="assets/superdesk.png" alt="SuperDesk" class="logo-large">
                <p class="brand-text">
                    Secure remote desktop sharing<br>
                    for modern teams
                </p>
            </div>
        </div>

        <!-- Right Panel - Content -->
        <div class="right-panel" id="rightPanel">
            <!-- Content will be dynamically loaded here -->
            <div id="contentArea">
                <!-- Session Info -->
                <div class="content-header">
                    <h1 class="content-title">Desktop Sharing Session</h1>
                    <p class="content-subtitle">Share your screen securely with anyone, anywhere</p>
                </div>

                <!-- Session ID Card -->
                <div class="card">
                    <div class="card-label">Your Session ID</div>
                    <div class="card-value" id="sessionId">Connecting...</div>
                    <div class="card-hint">Share this ID with others to let them join your session</div>
                </div>

                <!-- Status Grid -->
                <div class="status-grid">
                    <div class="status-item">
                        <div class="status-label">Connection</div>
                        <div class="status-value" id="connectionStatus">
                            <span class="status-dot"></span>
                            Connected
                        </div>
                    </div>
                    <div class="status-item">
                        <div class="status-label">Peer Status</div>
                        <div class="status-value" id="peerStatus">
                            <span class="status-dot offline"></span>
                            Waiting
                        </div>
                    </div>
                    <div class="status-item">
                        <div class="status-label">Sharing</div>
                        <div class="status-value" id="sharingStatus">Not Started</div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="button-group">
                    <button class="btn btn-primary" onclick="window.openShareOptions()" id="shareBtn">
                        🎥 Start Sharing
                    </button>
                    <button class="btn btn-danger" onclick="window.stopScreenShare()" id="stopBtn" disabled>
                        ⏹️ Stop Sharing
                    </button>
                </div>

                <!-- Friends Section -->
                <div class="section-header mt-4">
                    <span class="section-icon">👥</span>
                    <span class="section-title">Friends</span>
                </div>
                
                <div class="input-group">
                    <input type="text" id="friendInput" placeholder="Enter friend ID or email...">
                    <button class="btn btn-secondary" onclick="window.sendFriendRequest()">Add Friend</button>
                </div>

                <div id="friendList" class="card">
                    <div style="text-align: center; opacity: 0.5; padding: 20px;">
                        No friends yet. Add friends to start collaborating!
                    </div>
                </div>

                <!-- Messages Section -->
                <div class="section-header mt-4">
                    <span class="section-icon">💬</span>
                    <span class="section-title">Messages</span>
                </div>

                <div class="card" id="messageArea" style="min-height: 200px; max-height: 300px; overflow-y: auto; margin-bottom: 16px;">
                    <div style="text-align: center; opacity: 0.5; padding: 40px 20px;">
                        No messages yet
                    </div>
                </div>

                <div class="input-group">
                    <input type="text" id="messageInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter') window.sendMessage()">
                    <button class="btn btn-secondary" onclick="window.sendMessage()">Send</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Share Options Modal -->
    <div class="modal-overlay" id="shareModal">
        <div class="modal">
            <button class="modal-close" onclick="window.closeShareModal()">✕</button>
            <h2 class="modal-header">Choose What to Share</h2>
            
            <div class="share-option selected" data-share-type="screen" onclick="window.selectShareOption('screen')">
                <div class="share-option-icon">🖥️</div>
                <div class="share-option-content">
                    <h3>Entire Screen</h3>
                    <p>Share your entire desktop with full control</p>
                </div>
            </div>

            <div class="share-option" data-share-type="window" onclick="window.selectShareOption('window')">
                <div class="share-option-icon">🪟</div>
                <div class="share-option-content">
                    <h3>Application Window</h3>
                    <p>Share a specific application window</p>
                </div>
            </div>

            <div class="share-option" data-share-type="area" onclick="window.selectShareOption('area')">
                <div class="share-option-icon">⬜</div>
                <div class="share-option-content">
                    <h3>Screen Area</h3>
                    <p>Select a specific area of your screen</p>
                </div>
            </div>

            <button class="btn btn-primary" onclick="window.startSelectedShare()" style="width: 100%; margin-top: 20px;">
                Start Sharing
            </button>
        </div>
    </div>

    <script src="renderer.js"></script>
    <script>
        // Window controls
        const remote = require('@electron/remote');

        window.minimizeWindow = function() {
            remote.getCurrentWindow().minimize();
        };

        window.closeWindow = function() {
            remote.getCurrentWindow().close();
        };

        // Share modal
        let selectedShareType = 'screen';

        window.openShareOptions = function() {
            document.getElementById('shareModal').classList.add('active');
        };

        window.closeShareModal = function() {
            document.getElementById('shareModal').classList.remove('active');
        };

        window.selectShareOption = function(type) {
            selectedShareType = type;
            document.querySelectorAll('.share-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            document.querySelector(`[data-share-type="${type}"]`).classList.add('selected');
        };

        window.startSelectedShare = function() {
            console.log('Starting share with type:', selectedShareType);
            window.closeShareModal();
            
            if (typeof window.startScreenShareWithType === 'function') {
                window.startScreenShareWithType(selectedShareType);
            }
            
            document.getElementById('sharingStatus').textContent = 'Active';
            document.getElementById('shareBtn').disabled = true;
            document.getElementById('stopBtn').disabled = false;
        };

        window.stopScreenShare = function() {
            document.getElementById('sharingStatus').textContent = 'Not Started';
            document.getElementById('shareBtn').disabled = false;
            document.getElementById('stopBtn').disabled = true;
        };

        // Friends
        window.sendFriendRequest = function() {
            const input = document.getElementById('friendInput');
            const friendId = input.value.trim();
            
            if (!friendId) {
                alert('Please enter a friend ID or email');
                return;
            }
            
            console.log('Sending friend request to:', friendId);
            input.value = '';
            alert(`Friend request sent to ${friendId}!`);
        };

        // Messaging
        window.sendMessage = function() {
            const input = document.getElementById('messageInput');
            const message = input.value.trim();
            
            if (!message) return;
            
            const messageArea = document.getElementById('messageArea');
            
            if (messageArea.querySelector('[style*="text-align: center"]')) {
                messageArea.innerHTML = '';
            }
            
            const messageEl = document.createElement('div');
            messageEl.style.cssText = 'background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px; margin-bottom: 8px;';
            messageEl.innerHTML = `
                <div style="font-weight: 600; margin-bottom: 4px; font-size: 13px;">You</div>
                <div style="font-size: 14px;">${message}</div>
            `;
            
            messageArea.appendChild(messageEl);
            messageArea.scrollTop = messageArea.scrollHeight;
            
            input.value = '';
        };

        // UI update functions
        function displaySessionId(sessionId) {
            document.getElementById('sessionId').textContent = sessionId;
        }

        function updateStatus(status) {
            console.log('Status:', status);
        }
    </script>
</body>
</html>
