<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SuperDesk Agent</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a006f;
            color: white;
            height: 100vh;
            overflow: hidden;
            -webkit-app-region: drag;
        }

        .titlebar {
            -webkit-app-region: drag;
            height: 40px;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(20px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .titlebar-title {
            font-size: 13px;
            font-weight: 500;
            opacity: 0.8;
        }

        .titlebar-controls {
            -webkit-app-region: no-drag;
            display: flex;
            gap: 10px;
        }

        .titlebar-button {
            width: 30px;
            height: 30px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .titlebar-button:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .titlebar-button.close:hover {
            background: #ef4444;
        }

        .container {
            height: calc(100vh - 40px);
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-app-region: no-drag;
        }

        /* Welcome Screen */
        .welcome-screen {
            text-align: center;
            animation: fadeIn 0.6s ease-in-out;
        }

        .welcome-screen.hidden {
            display: none;
        }

        .logo-container {
            margin-bottom: 60px;
            animation: scaleIn 0.8s ease-out;
        }

        .logo-container img {
            width: 400px;
            max-width: 80vw;
            filter: drop-shadow(0 10px 40px rgba(168, 85, 247, 0.4));
        }

        .welcome-title {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 20px;
            color: white;
            animation: slideUp 0.8s ease-out 0.2s both;
        }

        .welcome-subtitle {
            font-size: 20px;
            color: white;
            opacity: 0.9;
            margin-bottom: 60px;
            animation: slideUp 0.8s ease-out 0.4s both;
        }

        .start-button {
            padding: 18px 60px;
            font-size: 18px;
            font-weight: 600;
            background: #0a006f;
            border: 2px solid white;
            border-radius: 12px;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 40px rgba(255, 255, 255, 0.2);
            animation: slideUp 0.8s ease-out 0.6s both;
        }

        .start-button:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.1);
            box-shadow: 0 15px 50px rgba(255, 255, 255, 0.3);
        }

        /* Main Screen */
        .main-screen {
            width: 100%;
            max-width: 900px;
            padding: 40px;
            display: none;
            animation: fadeIn 0.6s ease-in-out;
        }

        .main-screen.active {
            display: block;
        }

        .screen-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .screen-header h2 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .screen-header p {
            font-size: 16px;
            opacity: 0.7;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 30px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .card:hover {
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px rgba(255, 255, 255, 0.1);
        }

        .card-header {
            font-size: 14px;
            font-weight: 600;
            opacity: 0.6;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .session-id {
            font-size: 28px;
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: white;
            margin-bottom: 10px;
        }

        .session-hint {
            font-size: 13px;
            opacity: 0.5;
        }

        .status-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .status-row:last-child {
            border-bottom: none;
        }

        .status-label {
            font-size: 15px;
            opacity: 0.7;
        }

        .status-value {
            font-size: 15px;
            font-weight: 600;
        }

        .status-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 8px;
            animation: pulse 2s infinite;
        }

        .status-indicator.connected {
            background: #10b981;
            box-shadow: 0 0 10px #10b981;
        }

        .status-indicator.disconnected {
            background: #ef4444;
        }

        .button-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            padding: 14px 28px;
            font-size: 15px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
            text-transform: none;
            letter-spacing: 0.3px;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn > span {
            position: relative;
            z-index: 1;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0a006f 0%, #1a0f8f 100%);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 4px 15px rgba(10, 0, 111, 0.3), 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow: 0 6px 25px rgba(10, 0, 111, 0.4), 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
            box-shadow: 0 2px 10px rgba(10, 0, 111, 0.3);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
        }

        .btn-danger {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
        }

        .btn-danger:hover {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(220, 38, 38, 0.4);
        }

        .btn-icon {
            width: 44px;
            height: 44px;
            padding: 0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-back {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 20px;
            margin-bottom: 20px;
            align-self: flex-start;
        }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.4);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @keyframes fadeOut {
            from {
                opacity: 1;
            }
            to {
                opacity: 0;
            }
        }

        @keyframes scaleIn {
            from {
                transform: scale(0.8);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        @keyframes slideUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }

        .capturing {
            animation: pulse 2s infinite;
        }
        
        /* Share Selection Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(10px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: rgba(10, 0, 111, 0.95);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 40px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            animation: modalSlideIn 0.3s ease-out;
            position: relative;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 25px;
            text-align: center;
            color: white;
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }

        .share-options {
            display: grid;
            gap: 15px;
            margin-bottom: 20px;
        }

        .share-option {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .share-option:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.4);
            transform: translateX(5px);
        }

        .share-option.selected {
            background: rgba(255, 255, 255, 0.15);
            border-color: white;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
        }

        .share-option-icon {
            font-size: 32px;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        .share-option-content h3 {
            margin: 0 0 5px 0;
            font-size: 18px;
        }

        .share-option-content p {
            margin: 0;
            font-size: 14px;
            opacity: 0.7;
        }

        /* Friends & Messaging Panels */
        .sidebar-panel {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .panel-title {
            font-size: 18px;
            font-weight: 600;
            color: white;
        }

        .friend-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .friend-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s;
        }

        .friend-item:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .friend-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .friend-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0a006f, #1a0f8f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 16px;
            position: relative;
        }

        .friend-status {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #10b981;
            position: absolute;
            bottom: 0;
            right: 0;
            border: 2px solid #0a006f;
        }

        .friend-status.offline {
            background: #6b7280;
        }

        .friend-actions {
            display: flex;
            gap: 8px;
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 13px;
            border-radius: 6px;
        }

        .input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .input-group input {
            flex: 1;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            transition: all 0.3s;
        }

        .input-group input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .input-group input:focus {
            outline: none;
            border-color: white;
            background: rgba(255, 255, 255, 0.15);
        }

        .message-area {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            padding: 15px;
            max-height: 300px;
            overflow-y: auto;
            margin-bottom: 15px;
        }

        .message {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 8px;
        }

        .message-sender {
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 4px;
            opacity: 0.8;
        }

        .message-text {
            font-size: 14px;
        }

        .message.own {
            background: linear-gradient(135deg, #0a006f, #1a0f8f);
            margin-left: 40px;
        }
        
        .subtitle {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1em;
            opacity: 0.9;
        }

        .session-panel {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            text-align: center;
        }
        
        .session-label {
            font-size: 14px;
            opacity: 0.8;
            margin-bottom: 10px;
        }
        
        .session-id {
            font-size: 24px;
            font-weight: bold;
            font-family: 'Courier New', monospace;
            background: rgba(0, 0, 0, 0.2);
            padding: 15px;
            border-radius: 8px;
            word-break: break-all;
        }

        .status-panel {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .status-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 15px;
        }

        .status-text {
            font-size: 14px;
            opacity: 0.9;
        }

        .controls {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        button {
            padding: 12px 18px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(45deg, #4CAF50, #45a049);
            color: white;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
        }

        button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
        }

        button:disabled {
            background: linear-gradient(45deg, #666, #444);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .btn-stop {
            background: linear-gradient(45deg, #f44336, #d32f2f);
            box-shadow: 0 4px 15px rgba(244, 67, 54, 0.3);
        }
        
        .btn-stop:hover:not(:disabled) {
            box-shadow: 0 6px 20px rgba(244, 67, 54, 0.4);
        }

        .instructions {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
            font-size: 14px;
            line-height: 1.6;
        }
        
        .instructions h3 {
            margin-top: 0;
            margin-bottom: 10px;
        }
        
        .instructions ol {
            margin: 10px 0;
            padding-left: 20px;
        }
        
        .instructions li {
            margin-bottom: 8px;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }

        .capturing {
            animation: pulse 2s infinite;
        }
    </style>
</head>
<body>
    <div class="titlebar">
        <div class="titlebar-title">SuperDesk Agent</div>
        <div class="titlebar-controls">
            <button class="titlebar-button" onclick="window.minimizeWindow()" title="Minimize">─</button>
            <button class="titlebar-button close" onclick="window.closeWindow()" title="Close">✕</button>
        </div>
    </div>

    <div class="container">
        <!-- Welcome Screen -->
        <div class="welcome-screen" id="welcomeScreen">
            <div class="logo-container">
                <img src="assets/superdesk.png" alt="SuperDesk">
            </div>
            <h1 class="welcome-title">Welcome to SuperDesk</h1>
            <p class="welcome-subtitle">Share your desktop securely with anyone, anywhere</p>
            <button class="start-button" onclick="window.showMainScreen()">
                🚀 Start Sharing
            </button>
        </div>

        <!-- Main Screen -->
        <div class="main-screen" id="mainScreen">
            <!-- Back Button -->
            <button class="btn btn-icon btn-back" onclick="window.goBackToWelcome()" title="Back to Home">
                ←
            </button>

            <div class="screen-header">
                <h2>Desktop Sharing</h2>
                <p>Your session is ready to share</p>
            </div>

            <div class="card">
                <div class="card-header">Your Session ID</div>
                <div class="session-id" id="sessionId">Connecting...</div>
                <div class="session-hint">Share this ID with others to let them join</div>
            </div>

            <div class="card">
                <div class="status-row">
                    <span class="status-label">Connection Status</span>
                    <span class="status-value">
                        <span class="status-indicator disconnected" id="statusIndicator"></span>
                        <span id="status">Initializing...</span>
                    </span>
                </div>
                <div class="status-row">
                    <span class="status-label">Screen Sharing</span>
                    <span class="status-value" id="sharingStatus">Not Started</span>
                </div>
            </div>

            <div class="button-group">
                <button class="btn btn-primary" onclick="window.openShareOptions()" id="shareOptionsBtn">
                    <span>🎥 Choose What to Share</span>
                </button>
                <button class="btn btn-secondary" onclick="window.startTestPattern()" id="testBtn">
                    <span>🧪 Test Pattern</span>
                </button>
                <button class="btn btn-danger" onclick="window.stopScreenShare()" id="stopBtn" disabled>
                    <span>⏹️ Stop Sharing</span>
                </button>
            </div>

            <!-- Friends Panel -->
            <div class="sidebar-panel">
                <div class="panel-header">
                    <span class="panel-title">👥 Friends</span>
                </div>
                <div class="input-group">
                    <input type="text" id="friendRequestInput" placeholder="Enter friend ID or email...">
                    <button class="btn btn-primary btn-small" onclick="window.sendFriendRequest()">
                        <span>Add</span>
                    </button>
                </div>
                <div class="friend-list" id="friendList">
                    <!-- Friends will be populated here -->
                    <div style="text-align: center; opacity: 0.5; padding: 20px;">
                        No friends yet. Add friends to start collaborating!
                    </div>
                </div>
            </div>

            <!-- Messaging Panel -->
            <div class="sidebar-panel">
                <div class="panel-header">
                    <span class="panel-title">💬 Messages</span>
                </div>
                <div class="message-area" id="messageArea">
                    <!-- Messages will be populated here -->
                    <div style="text-align: center; opacity: 0.5; padding: 20px;">
                        No messages yet
                    </div>
                </div>
                <div class="input-group">
                    <input type="text" id="messageInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter') window.sendMessage()">
                    <button class="btn btn-primary btn-small" onclick="window.sendMessage()">
                        <span>Send</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Share Options Modal -->
    <div class="modal-overlay" id="shareModal">
        <div class="modal">
            <button class="modal-close" onclick="window.closeShareModal()">✕</button>
            <h2 class="modal-header">Choose What to Share</h2>
            <div class="share-options">
                <div class="share-option" data-share-type="screen" onclick="window.selectShareOption('screen')">
                    <div class="share-option-icon">🖥️</div>
                    <div class="share-option-content">
                        <h3>Entire Screen</h3>
                        <p>Share your entire desktop with full control</p>
                    </div>
                </div>
                <div class="share-option" data-share-type="window" onclick="window.selectShareOption('window')">
                    <div class="share-option-icon">🪟</div>
                    <div class="share-option-content">
                        <h3>Application Window</h3>
                        <p>Share a specific application window</p>
                    </div>
                </div>
                <div class="share-option" data-share-type="area" onclick="window.selectShareOption('area')">
                    <div class="share-option-icon">⬜</div>
                    <div class="share-option-content">
                        <h3>Screen Area</h3>
                        <p>Select a specific area of your screen</p>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary" onclick="window.startSelectedShare()" id="startShareBtn" style="width: 100%; margin-top: 10px;">
                <span>Start Sharing</span>
            </button>
        </div>
    </div>

    <script src="renderer.js"></script>
    <script>
        // Screen transition
        window.showMainScreen = function() {
            const welcomeScreen = document.getElementById('welcomeScreen');
            const mainScreen = document.getElementById('mainScreen');
            
            welcomeScreen.style.animation = 'fadeOut 0.3s ease-out';
            setTimeout(() => {
                welcomeScreen.classList.add('hidden');
                mainScreen.classList.add('active');
            }, 300);
        };

        // Window controls
        const { ipcRenderer } = require('electron');
        const remote = require('@electron/remote');

        window.minimizeWindow = function() {
            remote.getCurrentWindow().minimize();
        };

        window.closeWindow = function() {
            remote.getCurrentWindow().close();
        };

        // UI update functions
        function displaySessionId(sessionId) {
            document.getElementById('sessionId').textContent = sessionId;
        }

        function updateStatus(status) {
            const statusEl = document.getElementById('status');
            const indicatorEl = document.getElementById('statusIndicator');
            statusEl.textContent = status;
            
            if (status.includes('Connected') || status.includes('Ready')) {
                indicatorEl.classList.remove('disconnected');
                indicatorEl.classList.add('connected');
            }
        }

        window.startScreenShare = function() {
            document.getElementById('sharingStatus').textContent = 'Active';
            document.getElementById('startBtn').disabled = true;
            document.getElementById('stopBtn').disabled = false;
            document.getElementById('testBtn').disabled = true;
        };

        window.stopScreenShare = function() {
            document.getElementById('sharingStatus').textContent = 'Not Started';
            document.getElementById('startBtn').disabled = false;
            document.getElementById('stopBtn').disabled = true;
            document.getElementById('testBtn').disabled = false;
        };

        window.startTestPattern = function() {
            document.getElementById('sharingStatus').textContent = 'Test Pattern';
            document.getElementById('testBtn').disabled = true;
            document.getElementById('stopBtn').disabled = false;
            document.getElementById('startBtn').disabled = true;
        };

        // Back navigation
        window.goBackToWelcome = function() {
            const welcomeScreen = document.getElementById('welcomeScreen');
            const mainScreen = document.getElementById('mainScreen');
            
            mainScreen.classList.remove('active');
            welcomeScreen.classList.remove('hidden');
            
            // Reset sharing state
            window.stopScreenShare();
        };

        // Share Options Modal
        let selectedShareType = 'screen';
        
        window.openShareOptions = function() {
            document.getElementById('shareModal').classList.add('active');
            // Pre-select screen option
            document.querySelectorAll('.share-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            document.querySelector('[data-share-type="screen"]').classList.add('selected');
        };

        window.closeShareModal = function() {
            document.getElementById('shareModal').classList.remove('active');
        };

        window.selectShareOption = function(type) {
            selectedShareType = type;
            document.querySelectorAll('.share-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            document.querySelector(`[data-share-type="${type}"]`).classList.add('selected');
        };

        window.startSelectedShare = function() {
            console.log('Starting share with type:', selectedShareType);
            window.closeShareModal();
            
            // Call the actual screen share function with the selected type
            if (typeof window.startScreenShareWithType === 'function') {
                window.startScreenShareWithType(selectedShareType);
            } else {
                // Fallback to default screen share
                window.startScreenShare();
            }
            
            document.getElementById('sharingStatus').textContent = 'Active';
            document.getElementById('shareOptionsBtn').disabled = true;
            document.getElementById('stopBtn').disabled = false;
            document.getElementById('testBtn').disabled = true;
        };

        // Override the default startScreenShare to open options modal
        const originalStartScreenShare = window.startScreenShare;
        window.startScreenShare = function() {
            window.openShareOptions();
        };

        // Friends System (ready for Supabase integration)
        window.sendFriendRequest = function() {
            const input = document.getElementById('friendRequestInput');
            const friendId = input.value.trim();
            
            if (!friendId) {
                alert('Please enter a friend ID or email');
                return;
            }
            
            console.log('Sending friend request to:', friendId);
            // TODO: Integrate with Supabase
            // await supabase.from('friend_requests').insert({ ... })
            
            input.value = '';
            alert(`Friend request sent to ${friendId}!`);
        };

        window.acceptFriendRequest = function(friendId) {
            console.log('Accepting friend request from:', friendId);
            // TODO: Integrate with Supabase
        };

        window.removeFriend = function(friendId) {
            console.log('Removing friend:', friendId);
            // TODO: Integrate with Supabase
        };

        // Messaging System (ready for Supabase integration)
        window.sendMessage = function() {
            const input = document.getElementById('messageInput');
            const message = input.value.trim();
            
            if (!message) return;
            
            console.log('Sending message:', message);
            
            // Add message to UI
            const messageArea = document.getElementById('messageArea');
            const messageEl = document.createElement('div');
            messageEl.className = 'message own';
            messageEl.innerHTML = `
                <div class="message-sender">You</div>
                <div class="message-text">${message}</div>
            `;
            
            // Remove "no messages" placeholder if present
            if (messageArea.querySelector('[style*="text-align: center"]')) {
                messageArea.innerHTML = '';
            }
            
            messageArea.appendChild(messageEl);
            messageArea.scrollTop = messageArea.scrollHeight;
            
            input.value = '';
            
            // TODO: Integrate with Supabase for real-time messaging
            // await supabase.from('messages').insert({ ... })
        };

        // Helper function to add received message
        window.receiveMessage = function(sender, text) {
            const messageArea = document.getElementById('messageArea');
            
            // Remove placeholder
            if (messageArea.querySelector('[style*="text-align: center"]')) {
                messageArea.innerHTML = '';
            }
            
            const messageEl = document.createElement('div');
            messageEl.className = 'message';
            messageEl.innerHTML = `
                <div class="message-sender">${sender}</div>
                <div class="message-text">${text}</div>
            `;
            messageArea.appendChild(messageEl);
            messageArea.scrollTop = messageArea.scrollHeight;
        };

        // Helper function to add friend to list
        window.addFriendToList = function(friend) {
            const friendList = document.getElementById('friendList');
            
            // Remove placeholder
            if (friendList.querySelector('[style*="text-align: center"]')) {
                friendList.innerHTML = '';
            }
            
            const friendEl = document.createElement('div');
            friendEl.className = 'friend-item';
            friendEl.innerHTML = `
                <div class="friend-info">
                    <div class="friend-avatar">
                        ${friend.name.charAt(0).toUpperCase()}
                        <div class="friend-status ${friend.online ? '' : 'offline'}"></div>
                    </div>
                    <div>
                        <div style="font-weight: 600;">${friend.name}</div>
                        <div style="font-size: 12px; opacity: 0.7;">${friend.online ? 'Online' : 'Offline'}</div>
                    </div>
                </div>
                <div class="friend-actions">
                    <button class="btn btn-primary btn-small" onclick="window.startChatWith('${friend.id}')">
                        <span>💬</span>
                    </button>
                    <button class="btn btn-secondary btn-small" onclick="window.removeFriend('${friend.id}')">
                        <span>✕</span>
                    </button>
                </div>
            `;
            friendList.appendChild(friendEl);
        };

        window.startChatWith = function(friendId) {
            console.log('Starting chat with:', friendId);
            // TODO: Open chat interface or switch to that friend's messages
        };
    </script>
</body>
</html>