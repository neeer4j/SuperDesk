{
  "name": "superdesk",
  "version": "1.0.0",
  "description": "Remote desktop access software for Windows",
  "main": "index.js",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:agent": "cd agent && npm run dev",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client",
    "vercel-build": "npm run build:client",
    "build:server": "cd server && npm run build",
    "build:agent": "cd agent && npm run build",
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm start",
    "start:agent": "cd agent && npm start",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install && cd ../agent && npm install && cd ../shared && npm install",
    "check-deployment": "node check-deployment.js",
    "deploy:check": "npm run check-deployment",
    "deploy:build": "npm run install:all && npm run build:client",
    "deploy:help": "echo \"📖 See DEPLOYMENT.md for deployment instructions\" && echo \"🔍 Run 'npm run check-deployment' to verify deployment status\""
  },
  "keywords": [
    "remote-desktop",
    "webrtc",
    "screen-sharing",
    "windows"
  ],
  "author": "Your Name",
  "license": "MIT",
  "workspaces": [
    "client",
    "server",
    "agent",
    "shared"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "node-abi": "^4.24.0",
    "prebuild-install": "^7.1.3"
  },
  "dependencies": {
    "icojs": "^0.20.1",
    "jimp": "^1.6.0"
  }
}
