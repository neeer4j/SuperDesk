              .
            </Typography>

            {/* Login Link */}
            <Box sx={{
              marginTop: '32px',
              textAlign: 'center'
            }}>
              <Typography component="span" sx={{
                fontSize: '14px',
                color: 'rgba(255, 255, 255, 0.6)'
              }}>
                Already have an account?{' '}
              </Typography>
              <Typography component="span" sx={{
                fontSize: '14px',
                color: 'white',
                fontWeight: 600,
                cursor: 'pointer',
                '&:hover': { textDecoration: 'underline' }
              }}>
                Login
              </Typography>
            </Box>
          </Box>
